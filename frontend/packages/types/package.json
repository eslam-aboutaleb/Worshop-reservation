{
  "name": "@ws/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript types for the workshop-reservation API (generated from OpenAPI plus hand-maintained SSE/error-code types).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:types": "openapi-typescript http://localhost:8000/openapi.json -o src/openapi.d.ts",
    "build": "tsc -b"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
