# PostgreSQL
POSTGRES_USER=workshop_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=workshop_reservations
DATABASE_URL=postgresql+asyncpg://workshop_user:replace-with-a-local-password@db:5432/workshop_reservations

# Security and deployment
AUTH_SECRET_KEY=replace-with-a-random-string-at-least-32-characters
# The account registered with this email can manage workshop sessions.
ADMIN_EMAIL=eslamehababoutaleb@gmail.com
CORS_ORIGINS=["http://localhost:3000", "http://localhost:80", "http://localhost"]
ACCESS_TOKEN_EXPIRE_DAYS=30
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SSE_HEARTBEAT_SECONDS=15
